{
  "name": "foodflow",
  "private": true,
  "description": "Plato: frontend / backend / database / docs",
  "scripts": {
    "share": "node scripts/share.mjs",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm run check:copy && npm run test:frontend && npm run test:backend && npm run test:database",
    "check:copy": "node scripts/check-copy.mjs",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:database": "node scripts/test-database.mjs",
    "openapi": "npm --prefix backend run openapi",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "deploy": "node scripts/deploy.mjs",
    "setup:database": "node scripts/setup-database.mjs"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  }
}
