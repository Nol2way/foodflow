// ดีพลอยเว็บจริงเป็น Cloudflare Worker ตัวเดียว: หน้าเว็บ (frontend/dist) + API (/api/*) โดเมนเดียวกัน
// คำสั่ง: npm run deploy (build หน้าเว็บแล้ว wrangler deploy)
// ความลับตั้งด้วย `npx wrangler secret put <ชื่อ>`: SUPABASE_URL, SUPABASE_ANON_KEY,
//   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, (GEMINI_API_KEY, LINE_CHANNEL_ACCESS_TOKEN ไม่บังคับ)
{
  "$schema": "./backend/node_modules/wrangler/config-schema.json",
  "name": "foodflow",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    // React Router: ทุกเส้นทางที่ไม่ใช่ไฟล์ ส่ง index.html
    "not_found_handling": "single-page-application",
    // /api/* ให้ backend ตอบ ไม่ตกไปเป็น index.html
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "ALLOWED_ORIGINS": "https://foodflow.sittha9986.workers.dev"
  },
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }],
  // รายงานรายวันทาง LINE: ตรวจทุกชั่วโมง (ต้องตั้ง LINE_CHANNEL_ACCESS_TOKEN ก่อนจึงจะส่ง)
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
